<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GuraFile.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GuraFile">
    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="管理根目录" />
            <ListView x:Name="RootsList" Grid.Row="1" AutomationProperties.Name="管理根目录" DisplayMemberPath="Path" SelectionMode="Single" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddRootButton" AutomationProperties.Name="添加管理根目录" Click="AddRootButton_Click" Content="添加" />
                <Button x:Name="RemoveRootButton" AutomationProperties.Name="移除管理根目录" Click="RemoveRootButton_Click" Content="移除" />
                <Button x:Name="ScanButton" AutomationProperties.Name="扫描所选根目录" Click="ScanButton_Click" Content="扫描" />
            </StackPanel>
            <Border Grid.Row="3" Height="1" Margin="0,4" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
            <TextBlock Grid.Row="4" FontSize="20" FontWeight="SemiBold" Text="用户标签" />
            <TextBox x:Name="TagNameBox" Grid.Row="5" AutomationProperties.Name="标签名称" MaxLength="100" PlaceholderText="输入标签名称" />
            <ListView x:Name="TagsList" Grid.Row="6" AutomationProperties.Name="用户标签" DisplayMemberPath="Name" SelectionChanged="TagsList_SelectionChanged" SelectionMode="Extended" />
            <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="6">
                <Button x:Name="CreateTagButton" AutomationProperties.Name="新建标签" Click="CreateTagButton_Click" Content="新建" />
                <Button x:Name="RenameTagButton" AutomationProperties.Name="重命名标签" Click="RenameTagButton_Click" Content="重命名" />
                <Button x:Name="DeleteTagButton" AutomationProperties.Name="删除标签" Click="DeleteTagButton_Click" Content="删除" />
            </StackPanel>
            <StackPanel Grid.Row="8" Orientation="Horizontal" Spacing="6">
                <Button x:Name="ApplyTagButton" AutomationProperties.Name="给所选文件贴标签" Click="ApplyTagButton_Click" Content="贴到文件" />
                <Button x:Name="RemoveTagButton" AutomationProperties.Name="从所选文件移除标签" Click="RemoveTagButton_Click" Content="从文件移除" />
            </StackPanel>
            <ToggleSwitch x:Name="TagFilterToggle" Grid.Row="9" AutomationProperties.Name="按所选标签筛选" Header="按所选标签筛选" Toggled="TagFilterToggle_Toggled" />
            <ComboBox x:Name="TagMatchBox" Grid.Row="10" AutomationProperties.Name="标签筛选匹配方式" SelectedIndex="0" SelectionChanged="TagMatchBox_SelectionChanged">
                <ComboBoxItem Content="满足任一标签" />
                <ComboBoxItem Content="满足全部标签" />
            </ComboBox>
            <TextBlock x:Name="TagStatusText" Grid.Row="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </Grid>

        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" AutomationProperties.Name="筛选文件" PlaceholderText="按名称、路径或扩展名筛选" TextChanged="SearchBox_TextChanged" />
            <Grid Grid.Row="1" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SortNameButton" AutomationProperties.Name="按名称排序" Click="SortButton_Click" Content="名称 ▲" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="Name" />
                <Button x:Name="SortPathButton" Grid.Column="1" AutomationProperties.Name="按路径排序" Click="SortButton_Click" Content="路径" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="Path" />
                <Button x:Name="SortExtensionButton" Grid.Column="2" AutomationProperties.Name="按扩展名排序" Click="SortButton_Click" Content="扩展名" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="Extension" />
                <Button x:Name="SortSizeButton" Grid.Column="3" AutomationProperties.Name="按大小排序" Click="SortButton_Click" Content="大小（字节）" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="Size" />
                <Button x:Name="SortModifiedButton" Grid.Column="4" AutomationProperties.Name="按修改时间排序" Click="SortButton_Click" Content="修改时间" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="Modified" />
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="状态" />
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <ProgressRing x:Name="FilesLoadingRing" Width="18" Height="18" Visibility="Collapsed" />
                <TextBlock x:Name="FilesStateText" VerticalAlignment="Center" Text="正在加载文件…" />
            </StackPanel>
            <ListView x:Name="FilesList" Grid.Row="3" AutomationProperties.Name="文件列表" SelectionChanged="FilesList_SelectionChanged" SelectionMode="Extended">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="126" />
                                <ColumnDefinition Width="136" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Extension}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding Size}" />
                            <TextBlock Grid.Column="4" Text="{Binding Modified}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="5" Text="{Binding Status}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="文件详情" />
            <TextBlock x:Name="DetailsText" Grid.Row="1" AutomationProperties.Name="所选文件详情" Text="未选择文件" TextWrapping="Wrap" />
            <Border Grid.Row="2" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
            <TextBlock Grid.Row="3" FontSize="20" FontWeight="SemiBold" Text="扫描状态" />
            <Grid Grid.Row="4" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="ScanProgressRing" Width="20" Height="20" Visibility="Collapsed" />
                    <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Text="空闲" />
                    <Button x:Name="CancelButton" AutomationProperties.Name="取消扫描" Click="CancelButton_Click" Content="取消" IsEnabled="False" />
                </StackPanel>
                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="失败项" />
                <ListView x:Name="FailureList" Grid.Row="2" AutomationProperties.Name="扫描失败项" />
            </Grid>
        </Grid>
    </Grid>
</Window>
